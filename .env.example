ENV=local
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/payments
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
# M7: leave these three unset for local dev (PLAINTEXT default). Against
# Redpanda Cloud, set KAFKA_SECURITY_PROTOCOL=SASL_SSL and the SASL
# credentials — see docs/adr/0009-deployment.md.
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
READ_MODEL_CONSUMER_GROUP=payments-read-model-v1
KAFKA_TOPIC_RETENTION_HOURS=168
PROCESSED_EVENTS_RETENTION_HOURS=192
